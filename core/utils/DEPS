# core/utils — layering rules. See tools/check_layering.py.
#
# A helper that imports a cognitive subsystem is not a helper, it is a
# dependency of one — and it makes the utility layer un-importable without
# the layer it sits under. Notify registered services through the container
# rather than importing their modules.
#
# Existing violations are grandfathered in config/layering_baseline.json,
# which may only shrink. This directory was added with ZERO new entries.

description = "Utilities: helpers, below everything that uses them."

